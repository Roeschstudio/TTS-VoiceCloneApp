{
  "name": "roesch-tts",
  "version": "1.0.0",
  "description": "Roesch TTS - Estudio de voz local con Qwen3-TTS",
  "main": "./out/main/index.js",
  "author": "Roesch TTS",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "fetch-runtime": "node scripts/fetch-runtime.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win",
    "dist:portable": "electron-vite build && electron-builder --win portable",
    "dist:installer": "electron-vite build && electron-builder --win nsis",
    "dist:dir": "electron-vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  }
}
